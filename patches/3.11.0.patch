diff --git a/Python/ceval.c b/Python/ceval.c
index 72f9c837..3e5d9eb6 100644
--- a/Python/ceval.c
+++ b/Python/ceval.c
@@ -1201,18 +1201,13 @@ eval_frame_handle_pending(PyThreadState *tstate)
     /* GIL drop request */
     if (_Py_atomic_load_relaxed_int32(&ceval2->gil_drop_request)) {
         /* Give another thread a chance */
-        if (_PyThreadState_Swap(&runtime->gilstate, NULL) != tstate) {
+        if (PyEval_SaveThread() != tstate) {
             Py_FatalError("tstate mix-up");
         }
-        drop_gil(ceval, ceval2, tstate);
 
         /* Other threads may run now */
 
-        take_gil(tstate);
-
-        if (_PyThreadState_Swap(&runtime->gilstate, tstate) != NULL) {
-            Py_FatalError("orphan tstate");
-        }
+        PyEval_RestoreThread(tstate);
     }
 
     /* Check for asynchronous exception. */
@@ -4739,7 +4734,7 @@ _PyEval_EvalFrameDefault(PyThreadState *tstate, _PyInterpreterFrame *frame, int
