#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: $0 VERSION [regrtest arguments...]" >&2
    exit 2
fi

version=${1#v}
shift
root=$(cd "$(dirname "$0")" && pwd)
source_tree="$root/build/v$version/cpython"
output=$("$root/build-test-extension" "$version")

bootstrap="$root/tests/bootstrap"
env PYTHONPATH="$bootstrap" FRAME_EVAL_EXTENSION="$output" \
    "$source_tree/python" -c \
    'import _frame_eval_test; assert _frame_eval_test.installed()'

if [[ $# -eq 0 ]]; then
    exclusions_file="$root/tests/exclusions/$version.txt"
    if [[ ! -f $exclusions_file ]]; then
        echo "missing CPython test exclusions: $exclusions_file" >&2
        exit 1
    fi
    declare -A exclusions=()
    while IFS= read -r test_name; do
        [[ -z $test_name || $test_name == \#* ]] && continue
        if [[ ! $test_name =~ ^test(_[A-Za-z0-9_]+|\.[A-Za-z0-9_]+)+$ ]]; then
            echo "invalid CPython test exclusion: $test_name" >&2
            exit 1
        fi
        exclusions["$test_name"]=1
    done < "$exclusions_file"
    test_list=$("$source_tree/python" -m test --list-tests)
    mapfile -t discovered_tests <<< "$test_list"
    selected_tests=()
    for test_name in "${discovered_tests[@]}"; do
        [[ ${exclusions["$test_name"]+excluded} ]] || selected_tests+=("$test_name")
    done
    set -- -j0 --timeout=300 \
        --ignore test.test_os.TimerfdTests.test_timerfd_TFD_TIMER_ABSTIME
    case $version in
        3.11.[0-7]|3.12.[01])
            set -- "$@" \
                --ignore test.test_multiprocessing_forkserver.test_threads.WithThreadsTestPool.test_terminate
            ;;
    esac
    set -- "$@" "${selected_tests[@]}"
fi
exec env PYTHONPATH="$bootstrap" FRAME_EVAL_EXTENSION="$output" \
    "$source_tree/python" -m test "$@"
