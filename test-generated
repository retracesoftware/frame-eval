#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: $0 VERSION [regrtest arguments...]" >&2
    exit 2
fi

version=${1#v}
shift
root=$(cd "$(dirname "$0")" && pwd)
source_tree="$root/build/v$version/cpython"
output=$("$root/build-test-extension" "$version")

bootstrap="$root/tests/bootstrap"
env PYTHONPATH="$output:$bootstrap" "$source_tree/python" -c \
    'import _frame_eval_test; assert _frame_eval_test.installed()'

if [[ $# -eq 0 ]]; then
    exclusions_file="$root/tests/exclusions/$version.txt"
    if [[ ! -f $exclusions_file ]]; then
        echo "missing CPython test exclusions: $exclusions_file" >&2
        exit 1
    fi
    exclusions=()
    while IFS= read -r test_name; do
        [[ -z $test_name || $test_name == \#* ]] && continue
        if [[ ! $test_name =~ ^test_[A-Za-z0-9_]+$ ]]; then
            echo "invalid CPython test exclusion: $test_name" >&2
            exit 1
        fi
        exclusions+=("$test_name")
    done < "$exclusions_file"
    set -- -j0 --timeout=1200 -x "${exclusions[@]}"
fi
exec env PYTHONPATH="$output:$bootstrap" "$source_tree/python" -m test "$@"
